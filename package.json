{
  "name": "no-the-roulette",
  "private": true,
  "version": "2.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && node scripts/verify-sw-runtime.mjs && node scripts/verify-fighter-assets.mjs --dist",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs && node scripts/verify-fighter-assets.mjs",
    "assets:sync": "node scripts/sync-fighters.mjs && node scripts/verify-fighter-assets.mjs",
    "assets:verify": "node scripts/verify-fighter-assets.mjs",
    "audit:randomness": "node scripts/audit-randomness.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "14.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.2.0",
    "prettier": "^3.9.9",
    "sharp": "^0.34.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
